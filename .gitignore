# Node
node_modules/

# Next.js build output
.next/
out/
dist/

# Environment files and secrets
.env*
!.env.example
config/gcp-key.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Test coverage and Jest cache
coverage/
.jest-cache/
.jest-test-results.json

# TypeScript build info
*.tsbuildinfo

# Next.js auto-generated type definitions
next-env.d.ts

# Editor & OS files
.vscode/
.idea/
.DS_Store
*.swp
Thumbs.db

# Caches
.swc/
.eslintcache

# Expo dev cache (stray if `expo start` is ever run from the repo root instead of
# apps/mobile, which has its own .gitignore entry for its own .expo/)
/.expo/

# Temporary & local artifacts
tmp/
*.tmp
*.bak

# Public generated assets
public/openapi.json
app/theme-tokens.generated.css

# Generated code-reference docs (TypeDoc) — see `npm run docs:code`
docs-generated/

# Local AI agent guidance (keep local overrides out of commits)
.claude/
.vercel
