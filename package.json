{
  "name": "portrayal",
  "version": "0.26.2",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/andylacroce/character-chatbot-generator.git"
  },
  "author": "Andy Lacroce",
  "workspaces": [
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "npm run theme:generate && npm run docs:api && npm run db:check",
    "build": "npm run theme:generate && npm run docs:api && next build",
    "ci": "npm run format && npm run lint -- --max-warnings=0 && npm run lint:md && npm run type-check && npm run ci --workspace=apps/mobile && npm test --workspace=packages/shared && npm run db:check && npm run docs:code && npm run test:coverage && npm run build && npm run e2e",
    "vercel-build": "npm run theme:generate && npm run docs:api && next build",
    "theme:generate": "node scripts/generate-theme-css.cjs",
    "docs:api": "node scripts/generate-openapi.cjs",
    "docs:code": "typedoc --options config/typedoc.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:md": "markdownlint --config config/markdownlint.json \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"apps/mobile/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "test:coverage": "jest --coverage --silent --coverageReporters=text --coverageReporters=text-summary",
    "sim:games": "tsx --env-file=.env.local scripts/simulate-games.ts",
    "type-check": "tsc --noEmit",
    "prepare": "node ./scripts/setup-git-hooks.cjs",
    "type-check:watch": "tsc --noEmit --watch",
    "analyze": "ANALYZE=true next build",
    "db:push": "drizzle-kit push --config config/drizzle.config.ts",
    "db:check": "node scripts/check-db-schema.cjs",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config config/drizzle.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.6",
    "@scalar/nextjs-api-reference": "^0.12.4",
    "@trendmicro/react-toggle-switch": "^0.5.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "critters": "^0.0.25",
    "drizzle-orm": "^0.45.2",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.2",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-window": "^2.3.1",
    "sanitize-filename": "^1.6.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-jest": "^30.4.1",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-jsdoc": "^64.4.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.0.1",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.1",
    "markdownlint-cli": "^0.49.1",
    "node-mocks-http": "^1.18.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.8",
    "react-native": "^0.86.3",
    "style-dictionary": "^5.5.5",
    "swagger-jsdoc": "^6.3.0",
    "typedoc": "^0.28.20",
    "typescript": "^6"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "undici": "^6.23.0",
    "postcss": "^8.5.15",
    "js-yaml": "^4.3.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always"
  }
}
