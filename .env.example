# Environment variables for local development
# Copy this file to .env.local and fill in your actual values

# Anthropic API key for chat and avatar prompt generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud service account JSON file path (for TTS and Gemini image generation on
# Google Cloud's Gemini Enterprise Agent Platform, formerly Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS_JSON=config/gcp-key.json

# GCP project ID (required for Gemini image generation / avatar generation)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Vercel Blob storage token (optional, for logging)
VERCEL_BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# API secret for securing internal API endpoints
API_SECRET=your_api_secret_here

# --- Account persistence (optional; app works fully without these — see CLAUDE.md) ---

# Neon Postgres connection string. Without it, sign-in still works (JWT session) but
# no user/account row is ever persisted.
DATABASE_URL=postgres://user:password@host/dbname

# Auth.js (NextAuth v4) session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Base URL Auth.js uses to build redirect/callback URLs. Without it, NextAuth falls back
# to inferring it from request headers, which prints a startup warning and isn't reliable
# in every environment.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth app credentials (Google Cloud Console -> APIs & Services -> Google Auth
# Platform -> Clients). Redirect URI to register there: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
