# Environment variables for local development
# Copy this file to .env.local and fill in your actual values

# Anthropic API key for chat and avatar prompt generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud service account JSON file path (for TTS)
GOOGLE_APPLICATION_CREDENTIALS_JSON=config/gcp-key.json

# Google Analytics 4 measurement ID override (optional). Production uses the site's
# built-in ID; set this to use a different stream or to test the opt-in flow locally.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager container ID override (optional). Production uses the site's
# built-in GTM container; set this to use a different container or test locally.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Vercel Blob storage token (optional, for logging)
VERCEL_BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# --- Avatar generation (optional; app works fully without these — see CLAUDE.md) ---
# Both free. Cloudflare Workers AI (Flux Schnell) is tried first when set; without it
# (or if it fails), avatar generation falls back to Pollinations.ai, which needs no
# config at all.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# API secret for securing internal API endpoints
API_SECRET=your_api_secret_here

# --- Account persistence (optional; app works fully without these — see CLAUDE.md) ---

# Neon Postgres connection string. Without it, sign-in still works (JWT session) but
# no user/account row is ever persisted.
DATABASE_URL=postgres://user:password@host/dbname

# Auth.js (NextAuth v4) session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Base URL Auth.js uses to build redirect/callback URLs. Without it, NextAuth falls back
# to inferring it from request headers, which prints a startup warning and isn't reliable
# in every environment.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth app credentials (Google Cloud Console -> APIs & Services -> Google Auth
# Platform -> Clients). Redirect URIs to register there:
#   <NEXTAUTH_URL>/api/auth/callback/google (both web sign-in AND the mobile sign-in
#     bridge — apps/mobile piggybacks on this exact same NextAuth callback rather than
#     talking to Google directly; see pages/api/auth/mobile-auth-start.ts's doc comment.
#     No separate mobile-specific redirect URI needs registering here.)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Comma-separated allowlist of emails allowed to view the internal /admin stats page
# (aggregate usage from the analytics_events table). Optional; with none set, nobody is
# admin. Never honored on a Vercel Preview deployment regardless of this value — see
# src/utils/isAdmin.ts.
ADMIN_EMAILS=you@example.com

# Magic-link (email) sign-in, alongside Google. Optional; requires DATABASE_URL too
# (the one-time token is persisted via the Drizzle adapter). EMAIL_SERVER is a plain
# SMTP connection string handed to nodemailer — works with a Gmail App Password
# (smtps://portrayal-support%40andrewlacroce.com:app-password@smtp.gmail.com:465),
# Resend's SMTP endpoint, or any other SMTP provider. Use the "smtps://" scheme (not
# "smtp://") for port 465 — nodemailer maps "smtp:" to secure:false (STARTTLS-style),
# but 465 is implicit TLS from the first byte, so "smtp://...:465" connects in
# plaintext and fails; "smtp://...:587" with STARTTLS is the alternative if you'd
# rather keep the "smtp://" scheme. EMAIL_FROM must be a mailbox the EMAIL_SERVER
# credentials are actually allowed to send as.
EMAIL_SERVER=smtps://user:pass@smtp.gmail.com:465
EMAIL_FROM=portrayal-support@andrewlacroce.com
